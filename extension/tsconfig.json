{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    // Replaces WXT's generated aliases, so `@/*` is repeated here.
    "paths": {
      "@/*": ["./src/*"],
      "@/wasm/pkg/*": ["./src/wasm/pkg/*", "./src/wasm/fallback/*"]
    }
  },
  // The browser mixins run in Node and have their own tsconfig.
  "exclude": ["dev", "node_modules", ".output"]
}
