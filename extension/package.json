{
  "name": "hunch-extension",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "build:wasm": "node scripts/build-wasm.mjs",
    "browser": "node scripts/browser/run.mjs",
    "browser:install": "node scripts/browser/chrome.mjs",
    "browser:check": "node scripts/browser/run.mjs --check"
  },
  "dependencies": {
    "@hunch/ui": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@puppeteer/browsers": "^3.2.6",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "puppeteer-core": "^25.16.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12",
    "wxt": "^0.21.4"
  }
}
