{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hunch",
  "version": "0.1.0",
  "identifier": "app.hunch.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hunch",
        "width": 300,
        "height": 320,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "windowEffects": { "effects": ["acrylic"] }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Hunch",
    "shortDescription": "Detects the key and BPM of audio as it plays",
    "longDescription": "Hunch listens to an app or output device and shows the key and BPM of what is playing in a small overlay.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
