{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hunch",
  "version": "0.1.0",
  "identifier": "app.hunch.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hunch",
        "width": 300,
        "height": 320,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "windowEffects": { "effects": ["acrylic"] }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
