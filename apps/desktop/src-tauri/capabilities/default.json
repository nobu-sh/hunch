{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the main window's UI may do: hear session events and move, size and close its own window.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size"
  ]
}
