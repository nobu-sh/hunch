{
  "compilerOptions": {
    // DOM for the callbacks puppeteer runs inside pages.
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "target": "ESNext",
    "module": "Preserve",
    // Bundler resolution reads @hunch/ui's extensionless sources; only its types are imported.
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    // Node runs these mixins directly by stripping types, so only erasable syntax is allowed.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "include": ["."]
}
