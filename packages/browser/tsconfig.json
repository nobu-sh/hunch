{
  "compilerOptions": {
    // DOM for the callbacks puppeteer runs inside pages.
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    // Node runs the .ts sources directly by stripping types, so only erasable syntax is allowed.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "include": ["src", "*.ts"]
}
