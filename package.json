{
  "name": "hunch",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "browser": "pnpm --filter hunch-extension browser",
    "browser:install": "pnpm --filter hunch-extension browser:install",
    "browser:check": "pnpm --filter hunch-extension browser:check",
    "browser:screenshots": "pnpm --filter hunch-extension browser:screenshots"
  }
}
