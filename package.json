{
  "name": "hunch",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "browser": "hunch-browser",
    "browser:extension": "hunch-browser --mixin extension/browser/dev.ts",
    "browser:check": "hunch-browser --mixin extension/browser/check.ts"
  },
  "devDependencies": {
    "@hunch/browser": "workspace:*"
  }
}
